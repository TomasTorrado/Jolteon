# Leave VITE_API_URL unset to use the /api dev proxy in vite.config.js (recommended:
# same origin, so no CORS). Set it only when the API lives on another origin --
# then make sure that origin is in ALLOWED_ORIGINS for the FastAPI app.
# VITE_API_URL=http://127.0.0.1:8000

# Where the dev proxy forwards /api. Defaults to http://127.0.0.1:8000.
# VITE_API_TARGET=http://127.0.0.1:8000
